{
  "name": "mcp-midi-tool",
  "version": "0.2.0",
  "description": "Local MIDI composition, editing, playback and recording CLI and portable skill.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run --reporter=dot",
    "smoke:e2e": "npm run build && vitest run tests/cli_lifecycle.test.ts --reporter=dot",
    "cli": "node scripts/midi.mjs",
    "package:skill": "npm run build && node scripts/package_skill.mjs",
    "test:core": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "midi",
    "cli",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "midi": "^2.0.0",
    "midi-file": "^1.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
